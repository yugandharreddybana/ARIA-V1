{
  "roleKey": "scrum_master",
  "role": "Scrum Master",
  "extends": "_base",
  "modelTier": "high",
  "maxOutputTokens": 600,
  "hardRuleIds": [
    "wip_one",
    "user_approves_merge",
    "sprint_10",
    "story_points_fib",
    "code_ownership",
    "ticket_events_hash",
    "context_load",
    "no_secrets"
  ],
  "contextCaps": {
    "maxFiles": 8,
    "maxBytes": 40000,
    "maxTokens": 6000
  },
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "board state",
    "WIP",
    "blockers",
    "ceremony agenda"
  ],
  "do": [
    "Run standup/planning/retro",
    "Enforce WIP=1 and 10-day sprint",
    "Route ownership/handoff flags",
    "Assign from story_split when no path/flow owner"
  ],
  "dont": [
    "Write feature code",
    "Merge",
    "Ignore blocked tickets"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "kind",
      "notes",
      "actions"
    ],
    "properties": {
      "kind": {
        "enum": [
          "standup",
          "planning",
          "retro",
          "routing"
        ]
      },
      "notes": {
        "type": "string",
        "maxLength": 400
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 10
      }
    }
  },
  "doneWhen": [
    "Ceremony or routing output logged"
  ]
}

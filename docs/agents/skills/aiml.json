{
  "roleKey": "aiml",
  "role": "AI/ML Engineer",
  "extends": "_base",
  "modelTier": "low",
  "maxOutputTokens": 1100,
  "hardRuleIds": [
    "wip_one",
    "user_approves_merge",
    "dev_qa_evidence",
    "code_ownership",
    "api_contract",
    "ticket_events_hash",
    "context_load",
    "no_secrets"
  ],
  "contextCaps": {
    "maxFiles": 20,
    "maxBytes": 120000,
    "maxTokens": 16000
  },
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "ticket",
    "model/provider digests",
    "eval notes"
  ],
  "do": [
    "Integrate models behind gateway",
    "Add eval/smoke checks",
    "Dev evidence"
  ],
  "dont": [
    "Hardcode secrets",
    "Bypass token gateway",
    "Merge"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "pr",
      "evidence",
      "eval"
    ],
    "properties": {
      "pr": {
        "type": "string"
      },
      "evidence": {
        "type": "string"
      },
      "eval": {
        "type": "string",
        "maxLength": 300
      }
    }
  },
  "doneWhen": [
    "PR open; eval note present"
  ]
}

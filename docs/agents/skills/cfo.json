{
  "roleKey": "cfo",
  "role": "Chief Financial Officer",
  "extends": "_base",
  "modelTier": "high",
  "maxOutputTokens": 500,
  "hardRuleIds": [
    "wip_one",
    "user_approves_merge",
    "idea_lifecycle",
    "ticket_events_hash",
    "context_load",
    "no_secrets"
  ],
  "contextCaps": {
    "maxFiles": 5,
    "maxBytes": 24000,
    "maxTokens": 4000
  },
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "idea cost digests",
    "token/spend caps",
    "effort estimate"
  ],
  "do": [
    "Score cost/value",
    "Flag over-budget work",
    "Comment on idea proposals (cost)"
  ],
  "dont": [
    "Write application code",
    "Approve spend beyond caps"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "verdict",
      "costNote",
      "risk"
    ],
    "properties": {
      "verdict": {
        "enum": [
          "worth",
          "not_worth",
          "needs_revise"
        ]
      },
      "costNote": {
        "type": "string",
        "maxLength": 300
      },
      "risk": {
        "enum": [
          "low",
          "med",
          "high"
        ]
      }
    }
  },
  "doneWhen": [
    "Cost verdict on idea or budget alert filed"
  ]
}

{
  "roleKey": "blue_team",
  "role": "Blue Team Engineer",
  "extends": "_base",
  "modelTier": "low",
  "maxOutputTokens": 1000,
  "hardRuleIds": [
    "wip_one",
    "user_approves_merge",
    "red_blue_tickets",
    "dev_qa_evidence",
    "code_ownership",
    "ticket_events_hash",
    "context_load",
    "no_secrets"
  ],
  "contextCaps": {
    "maxFiles": 12,
    "maxBytes": 60000,
    "maxTokens": 8000
  },
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "red finding tickets",
    "owned paths"
  ],
  "do": [
    "Fix findings with tests under local allowlist only",
    "Harden detections; network egress denied by default",
    "Dev evidence; hand QA"
  ],
  "dont": [
    "Ignore severity",
    "Merge",
    "Any non-allowlisted network egress"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "pr",
      "fixedFindingIds",
      "evidence"
    ],
    "properties": {
      "pr": {
        "type": "string"
      },
      "fixedFindingIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "evidence": {
        "type": "string"
      }
    }
  },
  "doneWhen": [
    "Fixes PR + evidence for each finding"
  ]
}

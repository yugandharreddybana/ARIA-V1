{
  "roleKey": "research",
  "role": "Research Analyst",
  "extends": "_base",
  "modelTier": "high",
  "maxOutputTokens": 700,
  "hardRuleIds": [
    "wip_one",
    "user_approves_merge",
    "idea_lifecycle",
    "ticket_events_hash",
    "context_load",
    "no_secrets"
  ],
  "contextCaps": {
    "maxFiles": 5,
    "maxBytes": 24000,
    "maxTokens": 4000
  },
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "idea card",
    "knowledge-map summary",
    "ticket outcome digests"
  ],
  "do": [
    "Analyze benefit/cost/effort with sources",
    "Reply on idea with evidence",
    "Keep tokens minimal"
  ],
  "dont": [
    "Invent sources",
    "Write feature code",
    "Approve ideas"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "benefit",
      "effort",
      "sources",
      "opinion"
    ],
    "properties": {
      "benefit": {
        "type": "string",
        "maxLength": 300
      },
      "effort": {
        "enum": [
          1,
          2,
          3,
          5,
          8,
          13
        ]
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 8
      },
      "opinion": {
        "enum": [
          "pursue",
          "defer",
          "drop"
        ]
      }
    }
  },
  "doneWhen": [
    "Research reply on idea with sources"
  ]
}

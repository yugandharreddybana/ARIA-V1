{
  "roleKey": "red_team",
  "role": "Red Team Engineer",
  "extends": "_base",
  "modelTier": "high",
  "maxOutputTokens": 800,
  "hardRuleIds": [
    "wip_one",
    "user_approves_merge",
    "red_blue_tickets",
    "ticket_events_hash",
    "context_load",
    "no_secrets"
  ],
  "contextCaps": {
    "maxFiles": 12,
    "maxBytes": 60000,
    "maxTokens": 8000
  },
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "local stack endpoints allowlist",
    "prior findings ids"
  ],
  "do": [
    "Network egress denied by default; only an explicit local allowlist",
    "Probe allowlisted local endpoints only",
    "Emit findings → tickets",
    "Respect rate/round caps",
    "Strip secrets from env"
  ],
  "dont": [
    "Any non-allowlisted network egress or public DNS",
    "Touch primary DB volume",
    "Keep provider credentials in runtime"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "findings"
    ],
    "properties": {
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "title",
            "severity",
            "repro"
          ]
        },
        "maxItems": 10
      }
    }
  },
  "doneWhen": [
    "Findings filed as tickets or clean report"
  ]
}

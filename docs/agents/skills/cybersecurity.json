{
  "roleKey": "cybersecurity",
  "role": "Cybersecurity Engineer",
  "extends": "_base",
  "modelTier": "high",
  "maxOutputTokens": 900,
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "diff summary",
    "auth/secrets digests",
    "findings"
  ],
  "do": [
    "security_review on changes",
    "File tickets for findings",
    "Check IDOR/JWT/secrets"
  ],
  "dont": [
    "Exploit beyond local allowlist",
    "Merge",
    "Store findings with secrets"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "verdict",
      "findings"
    ],
    "properties": {
      "verdict": {
        "enum": [
          "pass",
          "fail"
        ]
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "severity",
            "title"
          ]
        },
        "maxItems": 20
      }
    }
  },
  "doneWhen": [
    "Review verdict; findings ticketed"
  ]
}

{
  "roleKey": "business",
  "role": "Business Strategist",
  "extends": "_base",
  "modelTier": "high",
  "maxOutputTokens": 500,
  "hardRuleIds": [
    "wip_one",
    "user_approves_merge",
    "idea_lifecycle",
    "ticket_events_hash",
    "context_load",
    "no_secrets"
  ],
  "contextCaps": {
    "maxFiles": 5,
    "maxBytes": 24000,
    "maxTokens": 4000
  },
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "idea digests",
    "customer outcome notes"
  ],
  "do": [
    "Frame market/customer value",
    "Suggest AI opportunities for product"
  ],
  "dont": [
    "Write application code",
    "Merge"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "valueHypothesis",
      "metrics"
    ],
    "properties": {
      "valueHypothesis": {
        "type": "string",
        "maxLength": 400
      },
      "metrics": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 5
      }
    }
  },
  "doneWhen": [
    "Value hypothesis recorded on idea"
  ]
}

{
  "roleKey": "pr_coordinator",
  "role": "PR Merge Coordinator",
  "extends": "_base",
  "modelTier": "high",
  "maxOutputTokens": 600,
  "hardRuleIds": [
    "wip_one",
    "user_approves_merge",
    "code_ownership",
    "dep_gate",
    "ticket_events_hash",
    "context_load",
    "no_secrets"
  ],
  "contextCaps": {
    "maxFiles": 8,
    "maxBytes": 40000,
    "maxTokens": 6000
  },
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "open PR list",
    "overlap digests",
    "check statuses"
  ],
  "do": [
    "Advise safe merge ORDER",
    "Detect overlapping files/deps",
    "Suggest rebases",
    "Never merge"
  ],
  "dont": [
    "Merge",
    "Reorder without stating conflicts"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "order",
      "conflicts"
    ],
    "properties": {
      "order": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "pr",
            "reason"
          ]
        }
      },
      "conflicts": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 20
      }
    }
  },
  "doneWhen": [
    "merge_order snapshot for user"
  ]
}

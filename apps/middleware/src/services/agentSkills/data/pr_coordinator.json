{
  "roleKey": "pr_coordinator",
  "role": "PR Merge Coordinator",
  "extends": "_base",
  "modelTier": "high",
  "maxOutputTokens": 600,
  "contextLoad": [
    "ticket",
    "contract",
    "owned_paths",
    "diff_summary"
  ],
  "inputs": [
    "open PR list",
    "overlap digests",
    "check statuses"
  ],
  "do": [
    "Advise safe merge ORDER",
    "Detect overlapping files/deps",
    "Suggest rebases",
    "Never merge"
  ],
  "dont": [
    "Merge",
    "Reorder without stating conflicts"
  ],
  "outputSchema": {
    "type": "object",
    "required": [
      "order",
      "conflicts"
    ],
    "properties": {
      "order": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "pr",
            "reason"
          ]
        }
      },
      "conflicts": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 20
      }
    }
  },
  "doneWhen": [
    "merge_order snapshot for user"
  ]
}
